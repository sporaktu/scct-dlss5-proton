+
+// Instead of Signal(fence_in, n): returns once everything queued on ctx so far has retired --
+// the copies into the shared set, and under async_home the read of Output. The host never
+// waits on the GPU for us, so this is what keeps it from reading half-written inputs.
+static bool CpuSyncDrain(ID3D11DeviceContext *ctx)
+{
+    ctx->End(g.sync_query);
+    ctx->Flush();
+    BOOL done = FALSE;
+    const ULONGLONG deadline = GetTickCount64() + 2000;
+    HRESULT hr;
+    while ((hr = ctx->GetData(g.sync_query, &done, sizeof(done), D3D11_ASYNC_GETDATA_DONOTFLUSH)) == S_FALSE)
+    {
+        if (GetTickCount64() > deadline) { Log("[feed32] cpu sync: the input copies did not retire within 2 s"); return false; }
+        SwitchToThread();
+    }
+    if (FAILED(hr)) Log("[feed32] cpu sync: event query failed 0x%08X", hr);
+    return SUCCEEDED(hr);
+}
+
+// The counter is 64-bit and the 32-bit add-on reads it too, where a plain load is two 32-bit
+// loads that can tear. A compare-exchange that never changes anything is an atomic read on both.
+static UINT64 CpuSyncDone()
+{
+    return static_cast<UINT64>(InterlockedCompareExchange64(reinterpret_cast<volatile LONG64 *>(&g.sync->done_n), 0, 0));
+}
+
+// Instead of Wait(fence_out, n): blocks until host64 says frame n is finished. The host only
+// publishes after its own CPU wait on its own fence_out, so Output is complete by then. False
+// on a host that died or went quiet; the caller treats that as a lost host.
+static bool CpuSyncWaitHost(UINT64 n)
+{
+    const ULONGLONG deadline = GetTickCount64() + 5000;
+    while (CpuSyncDone() < n)
+    {
+        const ULONGLONG now = GetTickCount64();
+        if (now >= deadline)
+        {
+            Log("[feed32] cpu sync: frame %llu not finished by the host within 5 s (host at %llu)",
+                static_cast<unsigned long long>(n), static_cast<unsigned long long>(CpuSyncDone()));
+            return false;
+        }
+        const HANDLE wait[2] = { g.sync_evt, g.hproc };
+        const DWORD r = WaitForMultipleObjects(2, wait, FALSE, static_cast<DWORD>(deadline - now));
+        if (r == WAIT_OBJECT_0 + 1 || r == WAIT_FAILED) return CpuSyncDone() >= n;
+    }
+    return true;
+}
