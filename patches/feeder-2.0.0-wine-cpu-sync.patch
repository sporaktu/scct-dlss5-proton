+// FEED_BUILD_CPU_SYNC (#121): the CPU-side stand-in for fence_out. Created once per host
+// process; a respawned host reopens the same names if the game still holds them.
+static HANDLE       g_sync_map, g_sync_evt;
+static FeedCpuSync *g_sync;
+
+static bool CpuSyncOpen(DWORD game_pid)
+{
+    if (g_sync != nullptr) return true;
+    wchar_t name[64];
+    swprintf_s(name, FEED_SYNC_MAP_FMT, static_cast<unsigned long>(game_pid));
+    g_sync_map = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(FeedCpuSync), name);
+    if (g_sync_map != nullptr)
+        g_sync = static_cast<FeedCpuSync *>(MapViewOfFile(g_sync_map, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(FeedCpuSync)));
+    swprintf_s(name, FEED_SYNC_EVT_FMT, static_cast<unsigned long>(game_pid));
+    g_sync_evt = CreateEventW(nullptr, FALSE, FALSE, name);
+    if (g_sync == nullptr || g_sync_evt == nullptr)
+    {
+        Log("[host] cpu sync: could not create the shared counter/event (error %lu)", GetLastError());
+        if (g_sync != nullptr) UnmapViewOfFile(g_sync);
+        if (g_sync_map != nullptr) CloseHandle(g_sync_map);
+        if (g_sync_evt != nullptr) CloseHandle(g_sync_evt);
+        g_sync = nullptr; g_sync_map = g_sync_evt = nullptr;
+        return false;
+    }
+    // A section the game still holds from the previous host would carry its exit value
+    // (UINT64_MAX) and satisfy every wait. The client's frame numbers only ever grow, so
+    // starting this session from zero is always safe.
+    InterlockedExchange64(reinterpret_cast<volatile LONG64 *>(&g_sync->done_n), 0);
+    return true;
+}
+
+// Tell a cpu_sync client that frame n is finished (or, with UINT64_MAX, that nothing it
+// waits on will ever come). Never moves the counter backwards.
+static void CpuSyncPublish(UINT64 n)
+{
+    if (!h.cpu_sync || g_sync == nullptr) return;
+    for (;;)
+    {
+        const LONG64 cur = static_cast<LONG64>(g_sync->done_n);
+        if (static_cast<UINT64>(cur) >= n) break;
+        if (InterlockedCompareExchange64(reinterpret_cast<volatile LONG64 *>(&g_sync->done_n),
+                                         static_cast<LONG64>(n), cur) == cur) break;
+    }
+    SetEvent(g_sync_evt);
+}
