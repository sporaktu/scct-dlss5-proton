+
+// wine_cpu_sync (#121): what stands in for fence_in/fence_out. All of it belongs to one host
+// session, exactly like the fences, and goes with them in HostClose.
+static void CpuSyncRelease()
+{
+    if (g.sync != nullptr)     { UnmapViewOfFile(g.sync); g.sync = nullptr; }
+    if (g.sync_map != nullptr) { CloseHandle(g.sync_map); g.sync_map = nullptr; }
+    if (g.sync_evt != nullptr) { CloseHandle(g.sync_evt); g.sync_evt = nullptr; }
